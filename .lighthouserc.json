{
  "ci": {
    "collect": {
      "staticDistDir": "./website/build",
      "url": [
        "http://localhost/index.html",
        "http://localhost/docs.html",
        "http://localhost/docs/overview/supply-chain.html",
        "http://localhost/devsecops/intro.html",
        "http://localhost/ai-coding/intro.html",
        "http://localhost/reference/samples/sbom.html"
      ],
      "numberOfRuns": 3
    },
    "assert": {
      "assertions": {
        "categories:accessibility": ["error", { "minScore": 0.95 }],
        "categories:best-practices": ["error", { "minScore": 0.95 }],
        "categories:seo": ["error", { "minScore": 0.9 }],
        "unsized-images": ["error", { "minScore": 1 }],
        "font-display": ["error", { "minScore": 1 }],
        "total-blocking-time": ["warn", { "maxNumericValue": 600 }],
        "unused-javascript": ["warn", { "maxNumericValue": 102400 }]
      }
    }
  }
}
