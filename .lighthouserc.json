{
  "ci": {
    "collect": {
      "url": [
        "http://localhost:4000/",
        "http://localhost:4000/docs",
        "http://localhost:4000/docs/overview/supply-chain",
        "http://localhost:4000/devsecops/intro",
        "http://localhost:4000/devsecops/sast",
        "http://localhost:4000/ai-coding/intro",
        "http://localhost:4000/reference/samples/sbom",
        "http://localhost:4000/en/"
      ],
      "numberOfRuns": 3,
      "startServerCommand": "yarn --cwd website docusaurus serve --no-open --port 4000",
      "startServerReadyPattern": "Serving",
      "startServerReadyTimeout": 60000
    },
    "assert": {
      "assertions": {
        "categories:accessibility": [
          "error",
          {
            "minScore": 0.95
          }
        ],
        "categories:best-practices": [
          "error",
          {
            "minScore": 0.95
          }
        ],
        "categories:seo": [
          "error",
          {
            "minScore": 0.9
          }
        ],
        "unsized-images": [
          "error",
          {
            "minScore": 1
          }
        ],
        "font-display": [
          "error",
          {
            "minScore": 1
          }
        ],
        "total-blocking-time": [
          "warn",
          {
            "maxNumericValue": 600
          }
        ],
        "unused-javascript": [
          "warn",
          {
            "maxNumericValue": 102400
          }
        ]
      }
    }
  }
}
